# Copy to .env and fill from the stack outputs:
#   aws cloudformation describe-stacks --stack-name shop-pipeline-demo --query 'Stacks[0].Outputs'
VITE_API_BASE=            # ApiUrl output, no trailing slash
VITE_COGNITO_DOMAIN=      # CognitoDomain output, without https://
VITE_COGNITO_CLIENT_ID=   # UserPoolClientId output
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
